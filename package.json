{
  "name": "rapid-buchhaltung",
  "productName": "Buchhaltung Rapid Openair",
  "version": "1.1.0",
  "description": "Buchhaltung für das Rapid Openair",
  "author": "Fabio Canetg",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "test": "node tools/test.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ch.fabiocanetg.rapid-buchhaltung",
    "productName": "Buchhaltung Rapid Openair",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Buchhaltung Rapid Openair",
      "artifactName": "Buchhaltung-Rapid-Openair-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
